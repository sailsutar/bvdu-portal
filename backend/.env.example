PORT=4000
NODE_ENV=production
ML_SERVICE_URL=http://127.0.0.1:8001

# Atlas — keep database name bvu_portal in the path before ?
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/bvu_portal?retryWrites=true&w=majority

JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
TOKEN_TTL_HOURS=12
STUDENT_DEFAULT_PASSWORD=abc@123
ADMIN_PASSWORD=admin123
TEACHER_GUIDE_PASSWORD=tg123
PARENT_DEFAULT_PASSWORD=parent123

# Frontend origin(s), comma-separated. Use * for open pilot.
# Example: https://bvu-portal.vercel.app,http://localhost:5173
CORS_ORIGINS=*
JSON_BODY_LIMIT=40mb

MESSAGE_DRY_RUN=0
MESSAGE_RATE_MAX=120
MESSAGE_BATCH_CONCURRENCY=5
MESSAGE_BATCH_DELAY_MS=80

BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=BVU Portal

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_VOICE_FROM=
